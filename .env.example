GROQ_API_KEY=your_key_here
PRORAG_LLM_PROVIDER=groq
PRORAG_LLM_CACHE=0
PRORAG_LLM_CACHE_PATH=.prorag_cache/llm_cache.json

# Optional: use a Hugging Face model id or a local SentenceTransformers path.
# If unset or unavailable, ProRAG falls back to deterministic hash embeddings.
PRORAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
